10 REM Guess the number / Adivina el numero
20 PRINT "GUESS THE NUMBER 1-100" : PRINT "ADIVINA EL NUMERO 1-100"
30 N = INT(RND(-1) * 100) + 1
40 TRIES = 0
50 PRINT
60 PRINT "Type a number and press RETURN"
70 INPUT "Your guess? "; G
80 TRIES = TRIES + 1
90 IF G = N THEN PRINT "CORRECT! - ¡ACERTASTE!": PRINT "TRIES: "; TRIES: GOTO 140
100 IF G < N THEN PRINT "TOO LOW - DEMASIADO BAJO": GOTO 70
110 IF G > N THEN PRINT "TOO HIGH - DEMASIADO ALTO": GOTO 70
120 GOTO 70
140 PRINT "Thanks for playing!" : END
